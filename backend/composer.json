{
    "name": "noir/spy-games",
    "description": "Noir — Шпионские игры (Symfony + WebSocket)",
    "type": "project",
    "license": "proprietary",
    "require": {
        "php": ">=8.2",
        "cboden/ratchet": "^0.4.4",
        "symfony/console": "^7.2",
        "symfony/dotenv": "^7.2",
        "symfony/framework-bundle": "^7.2",
        "symfony/runtime": "^7.2",
        "symfony/yaml": "^7.2"
    },
    "require-dev": {
        "symfony/var-dumper": "^7.2"
    },
    "autoload": {
        "psr-4": {
            "App\\": "src/"
        }
    },
    "config": {
        "allow-plugins": {
            "symfony/runtime": true
        },
        "sort-packages": true
    },
    "scripts": {
        "auto-scripts": {
            "cache:clear": "symfony-cmd"
        }
    }
}
